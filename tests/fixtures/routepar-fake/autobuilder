#!/usr/bin/env bash
# Fake `autobuilder` for routepar-selftest.sh (PRD-build-gate-route-
# parity-ledger). Modeled on tests/fixtures/gatephase-fake/autobuilder
# (same env-var-scriptable sleep/rc shape) but additionally WRITES a
# minimal, jq-parseable receipt JSON per producer (intake/vti-plan/
# rollback-plan/ci-checks, plus reviewer-agent's own via `finalize`) —
# gatephase-fake's producers never write receipts at all, which is fine
# for timing-only assertions but leaves nothing for THIS PRD's route-
# stamp sweep to stamp. Each receipt gets `"route"` added by extend-
# gate.sh itself; this fake only has to make sure the file exists first.
set -uo pipefail

sub="${1:-}"
[ $# -ge 1 ] && shift

sleep_for() { local s="${1:-0}"; [ "$s" = "0" ] || sleep "$s"; }

proj_from_args() {  # scans "$@" for --project <rel>, default "."
  local p="."
  while [ $# -gt 0 ]; do
    case "$1" in --project) p="$2"; shift 2 ;; *) shift ;; esac
  done
  printf '%s\n' "$p"
}

write_receipt() {  # $1=proj $2=name $3=verdict-json-fragment (e.g. '"verdict":"pass"')
  local proj="$1" name="$2" body="$3"
  local dir="$proj/target/autobuilder/receipts"
  mkdir -p "$dir"
  printf '{%s}\n' "$body" > "$dir/$name.json"
}

case "$sub" in
  intake)
    proj="$(proj_from_args "$@")"
    sleep_for "${FAKE_INTAKE_SLEEP:-0}"
    write_receipt "$proj" intake '"verdict":"pass"'
    exit "${FAKE_INTAKE_RC:-0}"
    ;;
  loop)
    proj="$(proj_from_args "$@")"
    sleep_for "${FAKE_LOOP_SLEEP:-0}"
    write_receipt "$proj" proof-receipt '"verdict":"pass"'
    exit "${FAKE_LOOP_RC:-0}"
    ;;
  vti-plan)
    proj="$(proj_from_args "$@")"
    sleep_for "${FAKE_VTI_PLAN_SLEEP:-0}"
    write_receipt "$proj" vti-plan '"verdict":"pass"'
    exit "${FAKE_VTI_PLAN_RC:-0}"
    ;;
  rollback-plan)
    proj="$(proj_from_args "$@")"
    sleep_for "${FAKE_ROLLBACK_PLAN_SLEEP:-0}"
    if [ "${FAKE_ROLLBACK_PLAN_RC:-0}" != "0" ]; then
      write_receipt "$proj" rollback-plan '"verdict":"block","block_reason":"fake-not-revert-clean","head_sha":"fake"'
    else
      write_receipt "$proj" rollback-plan '"verdict":"pass"'
    fi
    exit "${FAKE_ROLLBACK_PLAN_RC:-0}"
    ;;
  reviewer-agent)
    act="${1:-}"; [ $# -ge 1 ] && shift
    case "$act" in
      prepare)
        proj="$(proj_from_args "$@")"
        mkdir -p "$proj/target/autobuilder"
        echo '{}' > "$proj/target/autobuilder/review-request.json"
        sleep_for "${FAKE_REVPREPARE_SLEEP:-0}"
        exit "${FAKE_REVPREPARE_RC:-0}"
        ;;
      finalize)
        # --input <path> carries the JSON extend-gate.sh's own claude-fake
        # produced; this fake persists it verbatim to
        # receipts/reviewer-agent.json, standing in for the real binary's
        # own write. FAKE_REVFINALIZE_RC forces a rejection that never
        # writes the receipt (the "schema/mechanism problem, stale
        # receipt untouched" half of AC4).
        rev_input=""
        proj_arg="."
        while [ $# -gt 0 ]; do
          case "$1" in --input) rev_input="$2"; shift 2 ;; --project) proj_arg="$2"; shift 2 ;; *) shift ;; esac
        done
        sleep_for "${FAKE_REVFINALIZE_SLEEP:-0}"
        if [ "${FAKE_REVFINALIZE_RC:-0}" != "0" ]; then
          exit "${FAKE_REVFINALIZE_RC}"
        fi
        if [ -n "$rev_input" ] && [ -f "$rev_input" ]; then
          mkdir -p "$proj_arg/target/autobuilder/receipts"
          cp "$rev_input" "$proj_arg/target/autobuilder/receipts/reviewer-agent.json"
        fi
        exit 0
        ;;
      *) exit 0 ;;
    esac
    ;;
  ci-checks)
    proj="$(proj_from_args "$@")"
    sleep_for "${FAKE_CI_CHECKS_SLEEP:-0}"
    write_receipt "$proj" ci-checks '"verdict":"pass"'
    exit "${FAKE_CI_CHECKS_RC:-0}"
    ;;
  gate)
    sleep_for "${FAKE_GATE_SLEEP:-0}"
    head_sha="$(git rev-parse HEAD 2>/dev/null || echo unknown)"
    if [ "${FAKE_GATE_VERDICT:-pass}" = "block" ]; then
      echo "gate: head=$head_sha pass=24 block=1 verdict=block"
    else
      echo "gate: head=$head_sha pass=25 block=0 verdict=pass"
    fi
    exit "${FAKE_GATE_RC:-0}"
    ;;
  --version)
    echo "autobuilder 9.9.9"
    exit 0
    ;;
  *)
    exit 0
    ;;
esac
