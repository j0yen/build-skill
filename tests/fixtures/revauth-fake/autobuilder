#!/usr/bin/env bash
# Fake `autobuilder` for reviewer-receipt-selftest.sh (PRD-build-reviewer-
# receipt-primary, test_prefix rvrcpt). Modeled on tests/fixtures/
# routepar-fake/autobuilder (same env-var-scriptable sleep/rc/receipt-
# writing shape), with two differences this PRD's own ACs need:
#
#   - `reviewer-agent finalize --input <path>` still persists the input
#     verbatim to receipts/reviewer-agent.json (standing in for the real
#     binary's normalize-and-write), UNCHANGED from routepar-fake.
#   - `gate` now actually reads receipts/reviewer-agent.json off disk and
#     prints a real "  ✗ reviewer-agent — <note>" line when its decision
#     is block — routepar-fake's `gate` never did this (it only printed a
#     summary count), which is fine for route-stamping but gives R6's
#     gate_out family-name rewrite (extend-gate.sh, right after the real
#     `autobuilder gate` call) nothing to rewrite. FAKE_GATE_OTHER_BLOCK=1
#     adds a second, unrelated "  ✗ some-other-producer — ..." line so a
#     test can prove the rewrite touches ONLY the reviewer-agent line.
set -uo pipefail

sub="${1:-}"
[ $# -ge 1 ] && shift

sleep_for() { local s="${1:-0}"; [ "$s" = "0" ] || sleep "$s"; }

proj_from_args() {  # scans "$@" for --project <rel>, default "."
  local p="."
  while [ $# -gt 0 ]; do
    case "$1" in --project) p="$2"; shift 2 ;; *) shift ;; esac
  done
  printf '%s\n' "$p"
}

write_receipt() {  # $1=proj $2=name $3=verdict-json-fragment
  local proj="$1" name="$2" body="$3"
  local dir="$proj/target/autobuilder/receipts"
  mkdir -p "$dir"
  printf '{%s}\n' "$body" > "$dir/$name.json"
}

case "$sub" in
  intake)
    proj="$(proj_from_args "$@")"
    sleep_for "${FAKE_INTAKE_SLEEP:-0}"
    write_receipt "$proj" intake '"verdict":"pass"'
    exit "${FAKE_INTAKE_RC:-0}"
    ;;
  loop)
    proj="$(proj_from_args "$@")"
    sleep_for "${FAKE_LOOP_SLEEP:-0}"
    write_receipt "$proj" proof-receipt '"verdict":"pass"'
    exit "${FAKE_LOOP_RC:-0}"
    ;;
  vti-plan)
    proj="$(proj_from_args "$@")"
    sleep_for "${FAKE_VTI_PLAN_SLEEP:-0}"
    write_receipt "$proj" vti-plan '"verdict":"pass"'
    exit "${FAKE_VTI_PLAN_RC:-0}"
    ;;
  rollback-plan)
    proj="$(proj_from_args "$@")"
    sleep_for "${FAKE_ROLLBACK_PLAN_SLEEP:-0}"
    if [ "${FAKE_ROLLBACK_PLAN_RC:-0}" != "0" ]; then
      write_receipt "$proj" rollback-plan '"verdict":"block","block_reason":"fake-not-revert-clean","head_sha":"fake"'
    else
      write_receipt "$proj" rollback-plan '"verdict":"pass"'
    fi
    exit "${FAKE_ROLLBACK_PLAN_RC:-0}"
    ;;
  reviewer-agent)
    act="${1:-}"; [ $# -ge 1 ] && shift
    case "$act" in
      prepare)
        proj="$(proj_from_args "$@")"
        mkdir -p "$proj/target/autobuilder"
        echo '{}' > "$proj/target/autobuilder/review-request.json"
        sleep_for "${FAKE_REVPREPARE_SLEEP:-0}"
        exit "${FAKE_REVPREPARE_RC:-0}"
        ;;
      finalize)
        rev_input=""
        proj_arg="."
        while [ $# -gt 0 ]; do
          case "$1" in --input) rev_input="$2"; shift 2 ;; --project) proj_arg="$2"; shift 2 ;; *) shift ;; esac
        done
        sleep_for "${FAKE_REVFINALIZE_SLEEP:-0}"
        if [ "${FAKE_REVFINALIZE_RC:-0}" != "0" ]; then
          # PRD-build-gate-infra-outcome AC12: opt-in stderr line for the
          # "finalize rejected a valid verdict" scenario (e.g. a sha-prefix
          # mismatch) — additive only, every other FAKE_REVFINALIZE_RC test
          # is unaffected since this is empty unless explicitly set.
          [ -n "${FAKE_REVFINALIZE_STDERR:-}" ] && echo "$FAKE_REVFINALIZE_STDERR" >&2
          exit "${FAKE_REVFINALIZE_RC}"
        fi
        if [ -n "$rev_input" ] && [ -f "$rev_input" ]; then
          mkdir -p "$proj_arg/target/autobuilder/receipts"
          dest="$proj_arg/target/autobuilder/receipts/reviewer-agent.json"
          # --input can legitimately BE the receipt file itself now (R1:
          # extend-gate.sh passes the subagent's own fresh receipt straight
          # through) — cp would refuse "same file" in that case.
          if [ "$(cd "$(dirname "$rev_input")" && pwd)/$(basename "$rev_input")" \
             != "$(cd "$(dirname "$dest")" 2>/dev/null && pwd)/$(basename "$dest")" ]; then
            cp "$rev_input" "$dest"
          fi
        fi
        exit 0
        ;;
      *) exit 0 ;;
    esac
    ;;
  ci-checks)
    proj="$(proj_from_args "$@")"
    sleep_for "${FAKE_CI_CHECKS_SLEEP:-0}"
    write_receipt "$proj" ci-checks '"verdict":"pass"'
    exit "${FAKE_CI_CHECKS_RC:-0}"
    ;;
  gate)
    proj="$(proj_from_args "$@")"
    sleep_for "${FAKE_GATE_SLEEP:-0}"
    head_sha="$(git rev-parse HEAD 2>/dev/null || echo unknown)"
    rev_receipt="$proj/target/autobuilder/receipts/reviewer-agent.json"
    rev_decision=""
    [ -f "$rev_receipt" ] && rev_decision="$(sed -n 's/.*"decision"[[:space:]]*:[[:space:]]*"\([a-z]*\)".*/\1/p' "$rev_receipt" | head -1)"
    block_n=0
    if [ "$rev_decision" = "block" ]; then
      echo "  ✗ reviewer-agent — reviewer decision=block not in [\"pass\", \"concern\"]"
      block_n=$((block_n + 1))
    fi
    if [ "${FAKE_GATE_OTHER_BLOCK:-0}" = "1" ]; then
      echo "  ✗ some-other-producer — unrelated fixture block, never rewritten"
      block_n=$((block_n + 1))
    fi
    if [ "$block_n" -gt 0 ] || [ "${FAKE_GATE_VERDICT:-pass}" = "block" ]; then
      echo "gate: head=$head_sha pass=$((25 - block_n)) block=$block_n verdict=block"
      exit "${FAKE_GATE_RC:-1}"
    else
      echo "gate: head=$head_sha pass=25 block=0 verdict=pass"
      exit "${FAKE_GATE_RC:-0}"
    fi
    ;;
  --version)
    echo "autobuilder 9.9.9"
    exit 0
    ;;
  *)
    exit 0
    ;;
esac
