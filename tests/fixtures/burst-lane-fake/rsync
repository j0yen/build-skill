#!/usr/bin/env bash
# Fake rsync for burst-lane.sh offline tests: real local `cp` between the
# last two path-like args (src/dst may carry a "user@host:" prefix, which
# is stripped since our "remote" is a local scratch path). FAKE_RSYNC_FAIL=1
# simulates a network/rsync failure. Prints a --stats-shaped line so
# sync-back's/run's byte-count parse has something to match.
#
# requirement 10: a real incremental rsync transfers fewer bytes on a second
# pull of the same destination once it's warm. This fake can't replicate
# rsync's delta logic, so it fakes the *symptom* instead — a per-destination
# call counter (under FAKE_RSYNC_STATS_DIR, isolated per selftest tmpdir)
# halves the reported byte count each successive --stats call against the
# same dst, which is exactly what burst-lane-selftest.sh's two-consecutive-
# `run` assertion (PRD-build-burst-lane-ccx53 AC11) checks for.
set -uo pipefail
# PRD-build-burst-remote-disk-guard AC3: FAKE_RSYNC_FAIL_RC/FAKE_RSYNC_FAIL_MSG
# let a test pin the exact exit code and stderr line `run`'s named
# rsync-up-failed journaling (requirement 4) must surface — default rc/msg
# preserved for any older FAKE_RSYNC_FAIL=1 caller that never set them.
if [ "${FAKE_RSYNC_FAIL:-0}" = "1" ]; then
  echo "${FAKE_RSYNC_FAIL_MSG:-rsync: fake failure injected}" >&2
  exit "${FAKE_RSYNC_FAIL_RC:-23}"
fi

# PRD-build-burst-session-hygiene AC1: one line per rsync invocation, same
# shape as the fake ssh's own FAKE_SSH_KH_LOG — this is what proves an
# rsync call's own `-e "$SSH_BIN -o UserKnownHostsFile=... -o
# StrictHostKeyChecking=accept-new -i $SSH_KEY"` string carries the same
# session-scoped options every ssh call site does (rsync never gets bare
# `-o` argv of its own — both flags are embedded as substrings of the single
# `-e` argument, so this greps THAT argument rather than iterating argv
# pieces the way the ssh fixture does).
if [ -n "${FAKE_RSYNC_KH_LOG:-}" ]; then
  _kh_e=""
  for _kh_a in "$@"; do
    case "$_kh_a" in *UserKnownHostsFile=*) _kh_e="$_kh_a" ;; esac
  done
  _kh_uh="NONE"; _kh_shc="NONE"
  [[ "$_kh_e" == *UserKnownHostsFile=* ]] && _kh_uh="$(grep -oE 'UserKnownHostsFile=[^ ]+' <<<"$_kh_e")"
  [[ "$_kh_e" == *StrictHostKeyChecking=* ]] && _kh_shc="$(grep -oE 'StrictHostKeyChecking=[^ ]+' <<<"$_kh_e")"
  printf '%s %s\n' "$_kh_uh" "$_kh_shc" >> "$FAKE_RSYNC_KH_LOG"
fi

# PRD-build-burst-session-hygiene AC2/AC6: same changed-host-key fixture as
# the fake ssh — a `-e` string naming a UserKnownHostsFile whose content is
# exactly "STALE-HOST-KEY" fails exactly like a real rsync-over-ssh would
# against a reused IP with a mismatching global known_hosts entry.
for _kh_a in "$@"; do
  case "$_kh_a" in
    *UserKnownHostsFile=*)
      _kh_file="${_kh_a#*UserKnownHostsFile=}"; _kh_file="${_kh_file%% *}"
      if [ -f "$_kh_file" ] && grep -qx 'STALE-HOST-KEY' "$_kh_file" 2>/dev/null; then
        echo "@WARNING: REMOTE HOST IDENTIFICATION HAS CHANGED!" >&2
        exit 255
      fi
      ;;
  esac
done
src="${*: -2:1}"
dst="${*: -1:1}"
local_dst="${dst#*:}"
local_src="${src#*:}"
# PRD-build-burst-unprivileged-user: log both src and dst (whichever one
# carries "user@host:" is the remote side) so a selftest can prove no
# rsync call ever targeted root@ except this PRD's own allow-list (there
# is none for rsync — every real rsync in burst-lane.sh routes through
# $REMOTE_USER, which defaults to build).
if [ -n "${FAKE_RSYNC_CALL_LOG:-}" ]; then
  printf '%s\t%s\n' "$src" "$dst" >> "$FAKE_RSYNC_CALL_LOG"
fi
# PRD-build-gate-on-casper requirement 4: a FILE source (the single
# credential push, no trailing slash on either side — a real rsync copies
# a plain file to a plain file just fine) needs a plain file copy, not the
# directory-tree copy every other caller in this codebase uses. Every
# existing caller passes a directory for $local_src, so this branch never
# fires for them.
if [ -f "$local_src" ]; then
  mkdir -p "$(dirname "$local_dst")" 2>/dev/null || true
  cp -a "$local_src" "$local_dst" 2>/dev/null || true
else
  mkdir -p "$(dirname "$local_dst")" 2>/dev/null || true
  mkdir -p "$local_dst" 2>/dev/null || true
  cp -a "$local_src"/. "$local_dst"/ 2>/dev/null || true
fi
for a in "$@"; do
  if [ "$a" = "--stats" ]; then
    statedir="${FAKE_RSYNC_STATS_DIR:-${TMPDIR:-/tmp}/fake-rsync-stats}"
    mkdir -p "$statedir" 2>/dev/null || true
    key="$(printf '%s' "$local_dst" | cksum | cut -d' ' -f1)"
    cf="$statedir/$key"
    n="$(cat "$cf" 2>/dev/null || echo 0)"
    n=$((n + 1))
    echo "$n" > "$cf"
    bytes=$((40960 / n))
    echo "Total transferred file size: ${bytes} bytes"
  fi
done
exit 0
