#!/usr/bin/env bash
# Fake hcloud CLI for burst-lane.sh offline tests. State: a flat file of
# "id|name|alive" lines under $FAKE_HCLOUD_STATE (default
# /tmp/bl-fake-hcloud.state). Supports `server describe <id-or-name>` so
# burst-lane.sh's name-based adoption path (AC1) can be exercised without a
# real Hetzner account. Failure-injection env vars (all default off):
# FAKE_HCLOUD_AUTH_FAIL, FAKE_HCLOUD_CREATE_FAIL, FAKE_HCLOUD_DELETE_FAIL.
# Asserts the never-poweroff/shutdown/stop/reboot invariant (AC14) by
# hard-failing if any such subcommand is ever invoked.
#
# PRD-build-burst-persistent-volume: `volume {create,describe,attach,detach}`
# added, mirroring the server state file's own flat-line convention. State:
# "id|name|size_gb|server_id|device|created" lines under
# $FAKE_HCLOUD_VOLUME_STATE (default /tmp/bl-fake-hcloud-volume.state);
# server_id is empty when unattached, created is an ISO8601 timestamp
# (honors BURST_LANE_NOW, same seam as burst-lane.sh's own now_epoch()).
# Failure-injection: FAKE_HCLOUD_VOLUME_CREATE_FAIL,
# FAKE_HCLOUD_VOLUME_ATTACH_FAIL, FAKE_HCLOUD_VOLUME_DETACH_FAIL,
# FAKE_HCLOUD_VOLUME_DELETE_FAIL.
#
# PRD-build-burst-volume-id-parse: two more `volume create` behaviors, both
# rc0 (the server-side create really did succeed) so the fixture reproduces
# the two ways a real create response confuses a naive parser:
# FAKE_HCLOUD_VOLUME_CREATE_STDERR_NOISE=1 emits hcloud-style action-
# progress lines to STDERR around a clean JSON stdout (AC2 — proves the fix
# parses stdout alone); FAKE_HCLOUD_VOLUME_CREATE_GARBLED=1 emits
# non-JSON garbage to stdout instead of the real response, while still
# recording the volume in $FAKE_HCLOUD_VOLUME_STATE (server-side create
# succeeded — this is the untracked-create case, AC3/AC4).
set -uo pipefail
STATE="${FAKE_HCLOUD_STATE:-/tmp/bl-fake-hcloud.state}"
VOLSTATE="${FAKE_HCLOUD_VOLUME_STATE:-/tmp/bl-fake-hcloud-volume.state}"
IMGSTATE="${FAKE_HCLOUD_IMAGE_STATE:-/tmp/bl-fake-hcloud-image.state}"
CALLLOG="${FAKE_HCLOUD_CALLLOG:-}"
touch "$STATE" "$VOLSTATE" "$IMGSTATE"
[ -n "$CALLLOG" ] && printf '%s\n' "$*" >> "$CALLLOG"

case "${1:-}" in
  server-type)
    [ "${2:-}" = "list" ] || exit 2
    [ "${FAKE_HCLOUD_AUTH_FAIL:-0}" = "1" ] && { echo "unauthorized" >&2; exit 1; }
    echo "ccx53"
    exit 0
    ;;
  server)
    case "${2:-}" in
      create)
        [ "${FAKE_HCLOUD_CREATE_FAIL:-0}" = "1" ] && { echo "create failed" >&2; exit 1; }
        # parse --name from the argv
        name=""
        shift 2
        while [ $# -gt 0 ]; do
          if [ "$1" = "--name" ]; then name="$2"; fi
          shift
        done
        id=$((RANDOM % 900000 + 100000))
        echo "$id|$name|alive" >> "$STATE"
        printf '{"server":{"id":%s,"name":"%s","public_net":{"ipv4":{"ip":"127.0.0.1"}}}}\n' "$id" "$name"
        exit 0
        ;;
      describe)
        key="$3"
        line="$(grep -E "^$key\|" "$STATE" 2>/dev/null | head -n1)"
        [ -z "$line" ] && line="$(awk -F'|' -v k="$key" '$2==k' "$STATE" 2>/dev/null | head -n1)"
        [ -z "$line" ] && exit 1
        IFS='|' read -r id name alive <<<"$line"
        [ "$alive" = "alive" ] || exit 1
        printf '{"server":{"id":%s,"name":"%s","public_net":{"ipv4":{"ip":"127.0.0.1"}}}}\n' "$id" "$name"
        exit 0
        ;;
      delete)
        key="$3"
        sed -i -E "/^$key\|/d" "$STATE" 2>/dev/null || true
        awk -F'|' -v k="$key" '$2!=k' "$STATE" > "$STATE.tmp" 2>/dev/null && mv "$STATE.tmp" "$STATE"
        # PRD-build-burst-persistent-volume requirement 2: Hetzner detaches
        # any attached volume when its server is deleted, REGARDLESS of
        # whether burst-lane.sh's own prior `volume detach` call succeeded
        # (the whole point of "still deletes the server (Hetzner detaches on
        # delete)") — clear server_id on any volume this server id held.
        awk -F'|' -v OFS='|' -v k="$key" '$4==k{$4=""} {print}' "$VOLSTATE" > "$VOLSTATE.tmp" 2>/dev/null && mv "$VOLSTATE.tmp" "$VOLSTATE"
        [ "${FAKE_HCLOUD_DELETE_FAIL:-0}" = "1" ] && exit 1
        exit 0
        ;;
      poweroff|shutdown|stop|reboot)
        echo "FAKE-HCLOUD-VIOLATION: burst-lane.sh must never call 'server $2' (a stopped server still bills)" >&2
        exit 99
        ;;
      create-image)
        # PRD-build-burst-dispatch-reenable requirement 1 (bake): fake
        # `hcloud server create-image --type snapshot --description "..." -o
        # json <server-id>`. State: "id|status" lines appended to
        # $FAKE_HCLOUD_IMAGE_STATE (default /tmp/bl-fake-hcloud-image.state).
        # Returns status=available synchronously by default (real hcloud
        # blocks on the action); FAKE_HCLOUD_CREATE_IMAGE_FAIL injects a
        # failure, FAKE_HCLOUD_CREATE_IMAGE_PENDING makes the image start
        # "pending" so a caller's poll loop (via `image describe`) is
        # exercised — it flips to "available" after
        # FAKE_HCLOUD_CREATE_IMAGE_PENDING poll calls.
        [ "${FAKE_HCLOUD_CREATE_IMAGE_FAIL:-0}" = "1" ] && { echo "create-image failed" >&2; exit 1; }
        img_id=$((RANDOM % 900000 + 100000))
        img_status="available"
        [ "${FAKE_HCLOUD_CREATE_IMAGE_PENDING:-0}" -gt 0 ] 2>/dev/null && img_status="pending"
        echo "$img_id|$img_status|${FAKE_HCLOUD_CREATE_IMAGE_PENDING:-0}" >> "$IMGSTATE"
        printf '{"image":{"id":%s,"status":"%s"},"action":{"progress":100}}\n' "$img_id" "$img_status"
        exit 0
        ;;
      *) exit 2 ;;
    esac
    ;;
  image)
    case "${2:-}" in
      describe)
        key="$3"
        line="$(grep -E "^$key\|" "$IMGSTATE" 2>/dev/null | head -n1)"
        [ -z "$line" ] && exit 1
        IFS='|' read -r iid istatus ileft <<<"$line"
        if [ "$istatus" = "pending" ]; then
          ileft=$((ileft - 1))
          if [ "$ileft" -le 0 ]; then
            istatus="available"
          fi
          sed -i -E "s/^$iid\|[^|]*\|[^|]*/$iid|$istatus|$ileft/" "$IMGSTATE" 2>/dev/null || true
        fi
        printf '{"image":{"id":%s,"status":"%s"}}\n' "$iid" "$istatus"
        exit 0
        ;;
      *) exit 2 ;;
    esac
    ;;
  volume)
    case "${2:-}" in
      create)
        [ "${FAKE_HCLOUD_VOLUME_CREATE_FAIL:-0}" = "1" ] && { echo "volume create failed" >&2; exit 1; }
        name="" size=""
        shift 2
        while [ $# -gt 0 ]; do
          case "$1" in
            --name) name="$2"; shift 2 ;;
            --size) size="$2"; shift 2 ;;
            *) shift ;;
          esac
        done
        vid=$((RANDOM % 900000 + 100000))
        size="${size:-500}"
        device="/dev/disk/by-id/scsi-0HC_Volume_$vid"
        created_epoch="${BURST_LANE_NOW:-$(date -u +%s)}"
        created="$(date -u -d "@$created_epoch" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || date -u +%Y-%m-%dT%H:%M:%SZ)"
        # The server-side create below always happens first — every branch
        # from here on (clean, noisy-stderr, garbled-stdout) reflects a
        # volume that really exists and bills, mirroring the real API this
        # PRD's why-chain describes.
        echo "$vid|$name|$size||$device|$created" >> "$VOLSTATE"
        if [ "${FAKE_HCLOUD_VOLUME_CREATE_GARBLED:-0}" = "1" ]; then
          # PRD-build-burst-volume-id-parse AC3/AC4: rc0, but stdout is not
          # the JSON response at all — reproduces a create whose result the
          # lane cannot read even though nothing failed server-side.
          echo "unexpected-response: volume provisioning queued"
          exit 0
        fi
        if [ "${FAKE_HCLOUD_VOLUME_CREATE_STDERR_NOISE:-0}" = "1" ]; then
          # PRD-build-burst-volume-id-parse AC2: real `hcloud volume create`
          # (without --quiet) prints action-progress lines to stderr while
          # the action runs — stdout stays clean JSON throughout.
          printf '10%%\n' >&2
          printf '100%%\n' >&2
        fi
        printf '{"volume":{"id":%s,"name":"%s","size":%s,"linux_device":"%s","server":null,"created":"%s"}}\n' \
          "$vid" "$name" "$size" "$device" "$created"
        exit 0
        ;;
      describe)
        key="$3"
        line="$(grep -E "^$key\|" "$VOLSTATE" 2>/dev/null | head -n1)"
        [ -z "$line" ] && line="$(awk -F'|' -v k="$key" '$2==k' "$VOLSTATE" 2>/dev/null | head -n1)"
        [ -z "$line" ] && exit 1
        IFS='|' read -r vid name size sid device created <<<"$line"
        if [ -n "$sid" ]; then
          printf '{"volume":{"id":%s,"name":"%s","size":%s,"linux_device":"%s","server":%s,"created":"%s"}}\n' \
            "$vid" "$name" "$size" "$device" "$sid" "$created"
        else
          printf '{"volume":{"id":%s,"name":"%s","size":%s,"linux_device":"%s","server":null,"created":"%s"}}\n' \
            "$vid" "$name" "$size" "$device" "$created"
        fi
        exit 0
        ;;
      attach)
        [ "${FAKE_HCLOUD_VOLUME_ATTACH_FAIL:-0}" = "1" ] && { echo "volume attach failed" >&2; exit 1; }
        sid=""
        shift 2
        while [ $# -gt 0 ]; do
          case "$1" in
            --server) sid="$2"; shift 2 ;;
            *) key="$1"; shift ;;
          esac
        done
        line="$(grep -E "^$key\|" "$VOLSTATE" 2>/dev/null | head -n1)"
        [ -z "$line" ] && line="$(awk -F'|' -v k="$key" '$2==k' "$VOLSTATE" 2>/dev/null | head -n1)"
        [ -z "$line" ] && exit 1
        IFS='|' read -r vid name size old_sid device created <<<"$line"
        awk -F'|' -v k="$vid" 'BEGIN{OFS="|"} $1==k{next} {print}' "$VOLSTATE" > "$VOLSTATE.tmp" 2>/dev/null
        printf '%s|%s|%s|%s|%s|%s\n' "$vid" "$name" "$size" "$sid" "$device" "$created" >> "$VOLSTATE.tmp"
        mv "$VOLSTATE.tmp" "$VOLSTATE"
        exit 0
        ;;
      detach)
        [ "${FAKE_HCLOUD_VOLUME_DETACH_FAIL:-0}" = "1" ] && { echo "volume detach failed" >&2; exit 1; }
        key="$3"
        line="$(grep -E "^$key\|" "$VOLSTATE" 2>/dev/null | head -n1)"
        [ -z "$line" ] && line="$(awk -F'|' -v k="$key" '$2==k' "$VOLSTATE" 2>/dev/null | head -n1)"
        [ -z "$line" ] && exit 1
        IFS='|' read -r vid name size old_sid device created <<<"$line"
        awk -F'|' -v k="$vid" 'BEGIN{OFS="|"} $1==k{next} {print}' "$VOLSTATE" > "$VOLSTATE.tmp" 2>/dev/null
        printf '%s|%s|%s||%s|%s\n' "$vid" "$name" "$size" "$device" "$created" >> "$VOLSTATE.tmp"
        mv "$VOLSTATE.tmp" "$VOLSTATE"
        exit 0
        ;;
      delete)
        # PRD-build-burst-teardown-lifecycle requirement 5/6: cold-volume
        # teardown and reap --volumes/down --force's orphan sweep both call
        # `hcloud volume delete <id>` for real — mirrors `server delete`'s
        # own convention (match by id OR name, drop the line, rc0 even if
        # already gone). FAKE_HCLOUD_VOLUME_DELETE_FAIL injects a failure.
        [ "${FAKE_HCLOUD_VOLUME_DELETE_FAIL:-0}" = "1" ] && { echo "volume delete failed" >&2; exit 1; }
        key="$3"
        awk -F'|' -v k="$key" '$1!=k && $2!=k' "$VOLSTATE" > "$VOLSTATE.tmp" 2>/dev/null && mv "$VOLSTATE.tmp" "$VOLSTATE"
        exit 0
        ;;
      *) exit 2 ;;
    esac
    ;;
  *) exit 2 ;;
esac
