#!/usr/bin/env bash
# Fake ssh for burst-lane.sh offline tests. Last arg is the remote command:
# "true" for reachability probes, the bwrap sandbox-probe one-liner for
# sandbox_probe (succeeds unless FAKE_SSH_SANDBOX_FAIL=1), the
# MemAvailable/nproc/disk probe for cmd_sub_cap/cmd_run/cmd_status (canned
# via FAKE_SSH_MEMINFO_GB/FAKE_SSH_NPROC/FAKE_SSH_DISK_GB so the disk-guard
# PRD's exact avail_gb/nproc/free_disk_gb scenarios are reproducible without
# depending on the real test box's own /proc/meminfo or df; FAKE_SSH_DISK_MISSING=1
# reverts to the old two-field probe output for the bad-probe-output case),
# the `find ... -printf` reap listing (independently failable via
# FAKE_SSH_REAP_FAIL=<n>, distinct from FAKE_SSH_REMOTE_FAIL below, so a
# reap-only ssh failure can be exercised without also failing `run`'s remote
# exec), otherwise the "cd <remote_path> && export ...; <cargo cmd>" string
# (also covers reap's own `du -sb`/`rm -rf` calls), eval'd locally since our
# "remote" is really the local filesystem under BURST_LANE_REMOTE_ROOT.
# FAKE_SSH_REMOTE_FAIL=<n> makes the remote command "fail" with exit code n
# instead of running it.
set -uo pipefail
args=("$@")
cmd="${args[-1]}"

# PRD-build-burst-session-hygiene AC1: one line per ssh invocation, holding
# ONLY the two -o values this PRD cares about (never the whole "$*" —  a
# remote command's own multi-line body can span many lines and would make a
# naive whole-argv dump uncountable 1-line-per-call). "NONE" when a flag is
# absent, so a selftest can assert every line names both, and none ever
# names the real global known_hosts path. Opt-in (unset by default), so no
# pre-existing test's call-count assertions change shape.
if [ -n "${FAKE_SSH_KH_LOG:-}" ]; then
  _kh_uh="NONE"; _kh_shc="NONE"
  for _kh_a in "${args[@]}"; do
    case "$_kh_a" in
      UserKnownHostsFile=*)    _kh_uh="$_kh_a" ;;
      StrictHostKeyChecking=*) _kh_shc="$_kh_a" ;;
    esac
  done
  printf '%s %s\n' "$_kh_uh" "$_kh_shc" >> "$FAKE_SSH_KH_LOG"
fi

# PRD-build-burst-session-hygiene AC2/AC6: changed-host-key fixture. A
# UserKnownHostsFile whose content is exactly the sentinel line
# "STALE-HOST-KEY" simulates real ssh's behavior against a reused IP whose
# known_hosts entry no longer matches the box's actual host key — real ssh
# refuses with "REMOTE HOST IDENTIFICATION HAS CHANGED!" (exit 255) and
# never runs the remote command at all. Any OTHER file (including a
# freshly-created empty one — first contact, TOFU-pins and proceeds under
# accept-new) connects normally. Checked before every other case below so it
# applies uniformly to every call site (provision, gate, parity, reap
# probes, the plain `true` reachability probe — everything).
for ((_kh_i = 0; _kh_i < ${#args[@]}; _kh_i++)); do
  if [ "${args[$_kh_i]}" = "-o" ]; then
    case "${args[$((_kh_i + 1))]:-}" in
      UserKnownHostsFile=*)
        _kh_file="${args[$((_kh_i + 1))]#UserKnownHostsFile=}"
        if [ -f "$_kh_file" ] && grep -qx 'STALE-HOST-KEY' "$_kh_file" 2>/dev/null; then
          echo "@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@" >&2
          echo "@    WARNING: REMOTE HOST IDENTIFICATION HAS CHANGED!     @" >&2
          echo "@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@" >&2
          exit 255
        fi
        break
        ;;
    esac
  fi
done
# PRD-build-burst-unprivileged-user: every invocation's "user@host" target
# (always the arg immediately before the trailing command — every call site
# in burst-lane.sh follows `ssh -o ... -i key user@host cmd`) is logged
# alongside a one-line flattening of the command, so a selftest can prove
# WHO actually received each call (root@ vs build@) instead of trusting
# burst-lane.sh's own claims about its routing.
if [ -n "${FAKE_SSH_CALL_LOG:-}" ]; then
  printf '%s\t%s\n' "${args[-2]:-}" "$(printf '%s' "$cmd" | tr '\n' ' ')" >> "$FAKE_SSH_CALL_LOG"
fi
if [ "$cmd" = true ]; then exit 0; fi
case "$cmd" in
  *'# gate-tools-probe'*)
    # PRD-build-gate-on-casper requirement 1. Canned tool inventory:
    # FAKE_SSH_GATE_TOOLS_MISSING is a space-separated list of tool names
    # that report MISSING; a tool later "installed" via a
    # '# gate-tools-install <tool>' call in the SAME test run (tracked one
    # name per line in $FAKE_GATE_TOOLS_STATE) stops reporting MISSING on
    # every probe from then on — so a test can assert the up -> probe ->
    # install-missing -> re-probe round trip without any real apt-get/
    # curl/cargo-install ever running.
    #
    # PRD-build-burst-probe-visibility knobs (all opt-in; unset changes
    # nothing about the above):
    #   FAKE_SSH_GATE_TOOLS_PROBE_FAIL=1        ssh call itself "fails":
    #                                            no output, nonzero exit —
    #                                            AC6 (probe-unparseable).
    #   FAKE_SSH_GATE_TOOLS_PROBE_OMIT="t1 t2"  these tools are left out of
    #                                            the output entirely (never
    #                                            printed at all) — AC1
    #                                            (probe-absent).
    #   FAKE_SSH_GATE_TOOLS_PROBE_TRUNCATE=N    stop after the Nth tool
    #                                            line and never print the
    #                                            sentinel — AC9
    #                                            (probe-truncated).
    #   FAKE_SSH_GATE_TOOLS_PROBE_CRLF=1        every value line gets a
    #                                            trailing \r — AC7.
    #   FAKE_SSH_GATE_TOOLS_PROBE_NO_SENTINEL=1 print every tool line but
    #                                            withhold the sentinel —
    #                                            distinct truncation shape
    #                                            from _TRUNCATE (all tools
    #                                            seen, sweep still marked
    #                                            incomplete).
    #   FAKE_SSH_GATE_TOOLS_PROBE_CALLCOUNT_FILE + FAKE_SSH_GATE_TOOLS_
    #   MISSING_2ND="t1 t2"                     reproduces the exact
    #                                            2026-09-13 instability: the
    #                                            probe's answer changes
    #                                            between two calls seconds
    #                                            apart. Unset, every call
    #                                            answers from
    #                                            FAKE_SSH_GATE_TOOLS_MISSING
    #                                            as before; set, the 2nd and
    #                                            later call (counted in the
    #                                            given file) answers from
    #                                            FAKE_SSH_GATE_TOOLS_
    #                                            MISSING_2ND instead — a
    #                                            single provision calls the
    #                                            probe exactly twice
    #                                            (pre-install, final), so
    #                                            this flips exactly between
    #                                            them — AC5 (probe-
    #                                            disagreement).
    if [ "${FAKE_SSH_GATE_TOOLS_PROBE_FAIL:-0}" = "1" ]; then
      exit "${FAKE_SSH_GATE_TOOLS_PROBE_FAIL_RC:-1}"
    fi
    installed=""
    if [ -n "${FAKE_GATE_TOOLS_STATE:-}" ] && [ -f "$FAKE_GATE_TOOLS_STATE" ]; then
      installed="$(cat "$FAKE_GATE_TOOLS_STATE")"
    fi
    _gt_call_missing="${FAKE_SSH_GATE_TOOLS_MISSING:-}"
    if [ -n "${FAKE_SSH_GATE_TOOLS_PROBE_CALLCOUNT_FILE:-}" ]; then
      _gt_call_n=0
      [ -f "$FAKE_SSH_GATE_TOOLS_PROBE_CALLCOUNT_FILE" ] && _gt_call_n="$(cat "$FAKE_SSH_GATE_TOOLS_PROBE_CALLCOUNT_FILE")"
      _gt_call_n=$((_gt_call_n + 1))
      echo "$_gt_call_n" > "$FAKE_SSH_GATE_TOOLS_PROBE_CALLCOUNT_FILE"
      if [ "$_gt_call_n" -ge 2 ] && [ -n "${FAKE_SSH_GATE_TOOLS_MISSING_2ND:-}" ]; then
        _gt_call_missing="$FAKE_SSH_GATE_TOOLS_MISSING_2ND"
      fi
    fi
    _gt_n=0
    for t in autobuilder jq gh mold cargo-deny cargo-nextest uv claude; do
      _gt_omitted=0
      for o in ${FAKE_SSH_GATE_TOOLS_PROBE_OMIT:-}; do [ "$o" = "$t" ] && _gt_omitted=1; done
      [ "$_gt_omitted" = "1" ] && continue
      _gt_n=$((_gt_n + 1))
      if [ -n "${FAKE_SSH_GATE_TOOLS_PROBE_TRUNCATE:-}" ] && [ "$_gt_n" -gt "${FAKE_SSH_GATE_TOOLS_PROBE_TRUNCATE}" ]; then
        break
      fi
      missing=0
      for m in ${_gt_call_missing:-}; do [ "$m" = "$t" ] && missing=1; done
      for i in $installed; do [ "$i" = "$t" ] && missing=0; done
      if [ "$missing" = "1" ]; then
        _gt_line="$t=MISSING"
      elif [ "$t" = "autobuilder" ]; then
        # PRD-build-burst-gate-tools-scope requirement 1 (version-drift):
        # defaults to matching the standard fake local autobuilder used
        # across this selftest ("autobuilder 9.9.9", set once via
        # BURST_LANE_AUTOBUILDER_BIN) so no test trips version-drift by
        # accident; a dedicated test overrides this to something else.
        _gt_line="$t=${FAKE_SSH_AUTOBUILDER_VERSION:-autobuilder 9.9.9}"
      else
        _gt_line="$t=$t-fakeversion"
      fi
      if [ "${FAKE_SSH_GATE_TOOLS_PROBE_CRLF:-0}" = "1" ]; then
        printf '%s\r\n' "$_gt_line"
      else
        printf '%s\n' "$_gt_line"
      fi
    done
    if [ "${FAKE_SSH_GATE_TOOLS_PROBE_TRUNCATE:-}" = "" ] && [ "${FAKE_SSH_GATE_TOOLS_PROBE_NO_SENTINEL:-0}" != "1" ]; then
      printf '%s\n' "__GATE_PROBE_DONE__"
    fi
    exit 0
    ;;
  *'# gate-tools-apt-update'*)
    # PRD-build-burst-gate-tools-toolchain requirement 3. Default success;
    # FAKE_SSH_GATE_TOOLS_APT_UPDATE_FAIL=1 simulates an offline/blocked
    # apt mirror without touching any other install knob.
    [ "${FAKE_SSH_GATE_TOOLS_APT_UPDATE_FAIL:-0}" = "1" ] && exit "${FAKE_SSH_GATE_TOOLS_APT_UPDATE_RC:-1}"
    exit 0
    ;;
  *'# gate-tools-install '*)
    tool="$(printf '%s\n' "$cmd" | grep -oE '# gate-tools-install [a-zA-Z0-9_-]+' | head -n1 | awk '{print $3}')"
    rc=0
    errfile="$(mktemp "${TMPDIR:-/tmp}/fake-gate-install-err.XXXXXX")"
    if [ "${FAKE_SSH_GATE_TOOLS_INSTALL_FAIL:-0}" = "1" ]; then
      # Back-compat: every tool fails the same way (existing gatetools
      # tests only assert on the missing-list/fallback side, never stderr).
      echo "${FAKE_SSH_GATE_TOOLS_INSTALL_STDERR:-fake install failure}" >"$errfile"
      rc="${FAKE_SSH_GATE_TOOLS_INSTALL_RC:-1}"
    elif [ -n "${FAKE_SSH_GATE_TOOLS_INSTALL_FAIL_TOOL:-}" ] && [ "$tool" = "$FAKE_SSH_GATE_TOOLS_INSTALL_FAIL_TOOL" ]; then
      # PRD-build-burst-gate-tools-toolchain AC2: fail exactly ONE named
      # tool, with a caller-chosen rc/stderr, so a test can prove the
      # per-tool install-failed journal line without failing every tool.
      echo "${FAKE_SSH_GATE_TOOLS_INSTALL_FAIL_STDERR:-fake install failure}" >"$errfile"
      rc="${FAKE_SSH_GATE_TOOLS_INSTALL_FAIL_RC:-1}"
    elif [ "${FAKE_SSH_GATE_TOOLS_TOOLCHAIN_SIM:-0}" = "1" ] && { [ "$tool" = "cargo-deny" ] || [ "$tool" = "cargo-nextest" ]; }; then
      # AC1: actually run the real install snippet burst-lane.sh generated
      # (rustup toolchain list -> pick newest -> cargo +<newest> install),
      # with a fake rustup/cargo on PATH ahead of everything else, so the
      # toolchain-selection logic is proven for real rather than trusted.
      PATH="${FAKE_GATE_TOOLS_TOOLCHAIN_BIN:-/nonexistent}:$PATH" eval "$cmd" >"$errfile" 2>&1
      rc=$?
    fi
    cat "$errfile" >&2 2>/dev/null || true
    if [ "$rc" = "0" ] && [ -n "$tool" ] && [ -n "${FAKE_GATE_TOOLS_STATE:-}" ]; then
      mkdir -p "$(dirname "$FAKE_GATE_TOOLS_STATE")" 2>/dev/null || true
      echo "$tool" >> "$FAKE_GATE_TOOLS_STATE"
    fi
    rm -f "$errfile"
    exit "$rc"
    ;;
  *'# user-create'*)
    # PRD-build-burst-unprivileged-user: useradd/chmod/chown are real
    # system-mutating ops this fixture never has real root for — and must
    # never touch this dev machine's actual /root or $HOME even on a test
    # that points ROOT_CARGO_HOME/ROOT_RUSTUP_HOME at a real, working
    # toolchain for the cargo/rustup-invoking cases below. No-op them (in a
    # subshell so the overrides never leak out), keep mkdir/cat/id/touch
    # real against the tmpdir REMOTE_HOME/REMOTE_ROOT a test already scopes.
    ( useradd() { :; }; chmod() { :; }; chown() { :; }; eval "$cmd" )
    exit 0
    ;;
  *bwrap*)
    [ "${FAKE_SSH_SANDBOX_FAIL:-0}" = "1" ] && exit 1
    exit 0
    ;;
  *MemAvailable*)
    [ "${FAKE_SSH_PROBE_FAIL:-0}" = "1" ] && exit 1
    if [ "${FAKE_SSH_DISK_MISSING:-0}" = "1" ]; then
      echo "${FAKE_SSH_MEMINFO_GB:-8} ${FAKE_SSH_NPROC:-4}"
    else
      # Default disk is deliberately abundant (never the binding term) so
      # every pre-existing mem/cpu-only AC7 scenario keeps its old answer
      # unless a disk-guard test explicitly sets FAKE_SSH_DISK_GB low.
      echo "${FAKE_SSH_MEMINFO_GB:-8} ${FAKE_SSH_NPROC:-4} ${FAKE_SSH_DISK_GB:-100000}"
    fi
    exit 0
    ;;
  *MemTotal*)
    # PRD-build-burst-run-slots-from-box requirement 1/Technical
    # considerations: probe_box_specs' boot-time fingerprint (nproc/
    # MemTotal/df), a distinct fixture case from *MemAvailable* above (that
    # one answers probe_remote_capacity's live per-call reading; this one
    # answers cmd_up's once-per-session box probe). FAKE_BOX_CORES/
    # FAKE_BOX_MEM_GB/FAKE_BOX_DISK_GB name the box's own numbers per the
    # PRD's own naming; FAKE_BOX_PROBE_FAIL=1 simulates AC5's failed probe.
    [ "${FAKE_BOX_PROBE_FAIL:-0}" = "1" ] && exit 1
    if [ -z "${FAKE_BOX_CORES:-}${FAKE_BOX_MEM_GB:-}${FAKE_BOX_DISK_GB:-}" ]; then
      # No boxslots-specific knob was set for this call — every test written
      # before this PRD exercises `up` with no notion of a box probe at
      # all; failing here (rather than inventing a plausible box) keeps
      # every pre-existing test's box_cores/box_mem_gb/box_disk_gb empty
      # and its run_slot_cap() at source=default (cap 4), byte-for-byte the
      # same as before this PRD shipped (AC9: no previously green case
      # turns red).
      exit 1
    fi
    echo "${FAKE_BOX_CORES:-32} ${FAKE_BOX_MEM_GB:-128} ${FAKE_BOX_DISK_GB:-600}"
    exit 0
    ;;
  *-printf*)
    [ "${FAKE_SSH_REAP_FAIL:-0}" != "0" ] && exit "${FAKE_SSH_REAP_FAIL}"
    eval "$cmd"
    exit $?
    ;;
  *'# volume-mount'*)
    # PRD-build-burst-persistent-volume requirement 1: simulates the
    # label-check + conditional mkfs + mount + chown round trip without a
    # real block device (this fixture's "remote" is the local filesystem,
    # which has no /dev/disk/by-id/... to format). FAKE_SSH_VOLUME_LABEL_
    # PRESENT=1 simulates an already-formatted volume (no FORMATTED line,
    # no mkfs); default (0/unset) simulates a bare volume (echoes
    # FORMATTED, matching AC1's "formats only when no label found").
    # FAKE_SSH_VOLUME_MOUNT_FAIL=1 simulates a mount failure.
    [ "${FAKE_SSH_VOLUME_MOUNT_FAIL:-0}" = "1" ] && exit 1
    if [ "${FAKE_SSH_VOLUME_LABEL_PRESENT:-0}" != "1" ]; then
      echo FORMATTED
    fi
    mkdir -p "${BURST_LANE_REMOTE_ROOT:-}" 2>/dev/null || true
    echo MOUNTED
    exit 0
    ;;
  *'# volume-umount'*)
    # requirement 2 (teardown order): unmount before detach. Always
    # succeeds offline (nothing real is mounted); the local $REMOTE_ROOT
    # tmpdir is left in place since sweep_dirty_worktrees already ran.
    exit 0
    ;;
  *'# volume-fsck'*)
    # requirement 2: run once on the next `up` after a detach-failed marked
    # the volume dirty. FAKE_SSH_VOLUME_FSCK_CALLLOG (if set) records that
    # this ran, so a selftest can assert it without a real fsck binary.
    [ -n "${FAKE_SSH_VOLUME_FSCK_CALLLOG:-}" ] && echo "fsck" >> "$FAKE_SSH_VOLUME_FSCK_CALLLOG"
    exit 0
    ;;
  *'# volume-df'*)
    # requirement 4/status: canned usage line instead of a real df against
    # a real mounted filesystem. FAKE_SSH_VOLUME_USED_GB/SIZE_GB/PCT let a
    # test pin the exact numbers status --json / cost must surface.
    echo "${FAKE_SSH_VOLUME_USED_GB:-205}G ${FAKE_SSH_VOLUME_SIZE_GB:-500}G ${FAKE_SSH_VOLUME_USED_PCT:-41}%"
    exit 0
    ;;
  *'# cargo-home-registry-probe'*)
    # PRD-build-burst-path-deps AC3: cmd_verify's CARGO_HOME registry
    # writability check. FAKE_SSH_REGISTRY_WRITE_FAIL=1 simulates the
    # exact real-world defect this PRD fixes (a registry directory the
    # build user cannot write into) without touching any other probe.
    [ "${FAKE_SSH_REGISTRY_WRITE_FAIL:-0}" = "1" ] && exit 1
    eval "$cmd"
    exit $?
    ;;
  *'# pull-payload-probe'*)
    # PRD-build-burst-pull-back-restore AC12: do_marker_pull's remote
    # payload-size probe (`du -sb ... # pull-payload-probe`). Three
    # independent knobs, same deterministic-fake doctrine as the
    # gate-tools-probe case above:
    #   FAKE_SSH_PULL_PROBE_BYTES=<n>  probe succeeds, reports exactly n
    #                                  bytes (AC12's own case: a 3 GB
    #                                  payload is 3*1024^3).
    #   FAKE_SSH_PULL_PROBE_FAIL=1     the ssh call itself fails (rc 1, no
    #                                  output) — a real connectivity
    #                                  failure looks the same to the caller.
    #   FAKE_SSH_PULL_PROBE_HANG=1     never returns inside any bound this
    #                                  suite would set — proves the
    #                                  caller's own `timeout` wins the race
    #                                  rather than assuming it would.
    # None set: falls through to the real `eval "$cmd"`, which `du`s this
    # fixture's own real (fake-remote) target dir — exactly what
    # production does against a real box.
    [ "${FAKE_SSH_PULL_PROBE_FAIL:-0}" = "1" ] && exit 1
    if [ "${FAKE_SSH_PULL_PROBE_HANG:-0}" = "1" ]; then sleep 30; exit 0; fi
    if [ -n "${FAKE_SSH_PULL_PROBE_BYTES:-}" ]; then
      echo "$FAKE_SSH_PULL_PROBE_BYTES"
      exit 0
    fi
    eval "$cmd"
    exit $?
    ;;
  *'command -v cargo-nextest'*)
    # PRD-build-burst-parity-robust requirement 1: box-side nextest
    # presence check. Answered explicitly (never `eval`'d against this
    # dev/build machine's own real PATH, which really does have
    # cargo-nextest in ~/.cargo/bin) so every parity test is deterministic
    # regardless of what's actually installed here. Default is "missing"
    # (cargo-test fallback) — a test opts into the nextest path with
    # FAKE_SSH_NEXTEST_PRESENT=1.
    [ "${FAKE_SSH_NEXTEST_PRESENT:-0}" = "1" ] && exit 0
    exit 1
    ;;
  hostname)
    # PRD-build-burst-dispatch-reenable requirement 3 (prove): the box's own
    # identity, asked independently of anything cmd_run's journal claims
    # (the 2026-09-09 lesson — never trust the journal alone). Defaults to
    # THIS machine's own real hostname — i.e. indistinguishable from the
    # caller, the natural "host-mismatch" shape offline — so a test wanting
    # the success path must explicitly set FAKE_SSH_HOSTNAME to a distinct
    # value.
    echo "${FAKE_SSH_HOSTNAME:-$(hostname 2>/dev/null || echo unknown)}"
    exit 0
    ;;
  'date -u +%Y-%m-%dT%H:%M:%SZ')
    # PRD-build-burst-prove-forensics requirement 12: `run`'s own capture of
    # the box's clock at run start, for assert's skew_s diagnosis.
    # FAKE_SSH_REMOTE_DATE pins a deterministic answer (AC15); unset falls
    # through to this fixture's own real clock (this "remote" is really the
    # local filesystem, so there is no true skew to report offline).
    if [ -n "${FAKE_SSH_REMOTE_DATE:-}" ]; then
      echo "$FAKE_SSH_REMOTE_DATE"
    else
      date -u +%Y-%m-%dT%H:%M:%SZ
    fi
    exit 0
    ;;
esac
if [ "${FAKE_SSH_REMOTE_FAIL:-0}" != "0" ]; then exit "${FAKE_SSH_REMOTE_FAIL}"; fi
# PRD-build-burst-run-slots-from-box boxslots AC2: an opt-in delay on the
# actual remote build exec ONLY (every other case above returns above this
# point) — every other test in this suite runs with this unset and is
# unaffected. Needed to force real overlap between concurrently-launched
# `run` invocations for the ≤cap proof, the same reason burstpar-
# selftest.sh's own dedicated fake ssh sleeps in its exec case.
[ -n "${FAKE_SSH_RUN_DELAY_S:-}" ] && sleep "$FAKE_SSH_RUN_DELAY_S"
eval "$cmd"
