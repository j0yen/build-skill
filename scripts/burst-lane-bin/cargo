#!/usr/bin/env bash
# burst-lane-bin/cargo — thin shim (requirement 4, PRD-build-burst-lane-ccx53)
# so a worktree's ordinary `cargo test` (etc.) automatically routes through
# the burst lane when BURST_LANE=1 and a session is up, and falls straight
# through to the next cargo on PATH otherwise (which may be the local
# concurrency-budget shim from scripts/cargo-budget-bin/cargo if that's also
# on PATH behind this one — this shim does not disturb that fallback chain,
# it only inserts itself ahead of it).
#
# Routed through scripts/burst-lane.sh run "$PWD" -- <real cargo> "$@":
#   build, test, clippy, deny, nextest.
# Always local (never routed, session or not):
#   check, metadata — cheap/read-only, not the OOM source, and cargo
#   check's fast turnaround is worth more than a round-trip to the box.
#
# PRD-build-gate-cargo-route-attest requirement 2: every invocation of this
# shim — routed or not — appends one line to $BURST_ROUTE_LOG (default
# state/burst-lane/route.log) recording its decision (burst|local|
# passthrough) and cause, so a caller (extend-gate.sh) can attest where its
# own cargo calls actually went instead of assuming PATH order did its job.
set -uo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
WRAPPER="$HERE/../burst-lane.sh"
# PRD-build-gate-cargo-route-attest requirement 2: one line per invocation,
# flock-guarded, so a gate (or anything else) can attest exactly where its
# own cargo calls actually went instead of hoping. Default mirrors
# burst-lane.sh's own STATE_DIR convention (../state/burst-lane relative to
# this dir); BURST_ROUTE_LOG lets a caller (the gate) point at a per-run
# file so counts are per-gate, not global (AC6).
STATE_DIR="${BURST_LANE_STATE_DIR:-$HERE/../../state/burst-lane}"
ROUTE_LOG="${BURST_ROUTE_LOG:-$STATE_DIR/route.log}"

# route_log <subcommand> <decision: burst|local|passthrough> <cause>
# SIGPIPE-safe (plain file append under flock, never a pipe destination) and
# never fatal to the caller — a route-log write failure must never turn
# into a cargo call that silently didn't run.
route_log() {
  local sub="${1:--}" decision="$2" cause="${3:--}"
  mkdir -p "$(dirname "$ROUTE_LOG")" 2>/dev/null || return 0
  # Subshell (not a bare `{ }` group) so a failed/timed-out flock's `exit 0`
  # only ends the subshell, never this function's caller.
  (
    flock -w 2 204 2>/dev/null || exit 0
    printf '%s %s %s %s %s %s\n' \
      "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$$" "$sub" "$decision" "$cause" "$PWD" >&204
  ) 204>>"$ROUTE_LOG" 2>/dev/null || true
  return 0
}

# PRD-build-cargo-shim-recursion-guard protocol v2 (2026-09-18T15:10Z
# operator ruling): burst-lane-bin/cargo now honours the same guard
# cargo-budget-bin/cargo does (req1/req3 — "every wintermute cargo shim in
# this repo") — (2) refuse when this shim's own realpath is already in
# WM_CARGO_SHIM_CHAIN (the actual mutual-recursion signature, independent
# of depth); (4) WM_CARGO_SHIM_DEPTH is a backstop ceiling of 3 shim
# frames (designed chain cargo-budget-bin -> burst-lane-bin -> real
# cargo, depth 0->1->2), so a THIRD frame (depth already >= 2 at entry)
# refuses too. Live defect this closes (2026-09-18 19:39-19:46Z, pid
# 3902168): with no guard here at all, a PATH carrying rustbuild's shim
# ahead of the real cargo let this shim's own real_cargo() (below) treat
# rustbuild's shim as "the real cargo" and exec straight into it forever
# — 6,779 `--version passthrough unrouted-subcommand` route.log lines in
# under 7 minutes, never bounded because nothing here ever incremented or
# checked a depth. (3) Once $REAL_CARGO below is confirmed not another
# known shim, both vars are cleared for the child so a nested cargo call
# (an xtask/build.rs shelling back out) starts a fresh chain instead of
# inheriting an already-elevated depth and being wrongly refused.
_wm_shim_self="$HERE/cargo"
WM_CARGO_SHIM_DEPTH="${WM_CARGO_SHIM_DEPTH:-0}"
WM_CARGO_SHIM_CHAIN="${WM_CARGO_SHIM_CHAIN:-}"

_wm_shim_refuse() {
  route_log "${1:--}" local recursion-refused
  printf 'cargo-shim  recursion-refused (depth=%s path=%s)\n' "$WM_CARGO_SHIM_DEPTH" "${PATH%%:*}" >&2
  exit 9
}

case ":$WM_CARGO_SHIM_CHAIN:" in
  *":$_wm_shim_self:"*) _wm_shim_refuse "${1:-}" ;;
esac
[ "$WM_CARGO_SHIM_DEPTH" -ge 2 ] && _wm_shim_refuse "${1:-}"

export WM_CARGO_SHIM_DEPTH=$(( WM_CARGO_SHIM_DEPTH + 1 ))
export WM_CARGO_SHIM_CHAIN="${WM_CARGO_SHIM_CHAIN:+$WM_CARGO_SHIM_CHAIN:}$_wm_shim_self"

# Find the next real cargo behind this shim on PATH: skip this shim's own
# directory *and every other known cargo shim directory* — cargo-budget-bin
# (PRD-build-cargo-shim-reexec-loop) and rustbuild's bin
# (PRD-build-cargo-shim-recursion-guard, same realpath resolution
# cargo-budget-bin/cargo's own real_cargo() uses, requirement 2) — so that
# whichever of these is on PATH, none of them ever resolves another as
# "the real cargo". Previously this only skipped its own directory and
# cargo-budget-bin, which meant a PATH with rustbuild's shim ahead of the
# real cargo made this resolve straight into rustbuild's shim — the live
# defect above. Every dir compared by realpath (`pwd -P`) so a symlinked
# skill path can't re-admit a shim under a different name.
_rustbuild_target="$(readlink -f "$HOME/.claude/skills/rustbuild" 2>/dev/null || true)"
_rustbuild_bin=""
if [ -n "$_rustbuild_target" ] && [ -d "$_rustbuild_target/bin" ]; then
  _rustbuild_bin="$(cd "$_rustbuild_target/bin" 2>/dev/null && pwd -P || true)"
fi
SHIM_DIRS=(
  "$HERE"
  "$(cd "$HERE/../cargo-budget-bin" 2>/dev/null && pwd -P || true)"
  "$_rustbuild_bin"
)
real_cargo() {
  local dir bin resolved shim skip
  local saved_ifs="$IFS"
  IFS=:
  for dir in $PATH; do
    IFS="$saved_ifs"
    [ -n "$dir" ] || continue
    resolved="$(cd "$dir" 2>/dev/null && pwd -P || true)"
    [ -n "$resolved" ] || continue
    skip=0
    for shim in "${SHIM_DIRS[@]}"; do
      [ -n "$shim" ] || continue
      if [ "$resolved" = "$shim" ]; then skip=1; break; fi
    done
    [ "$skip" -eq 1 ] && continue
    bin="$dir/cargo"
    if [ -x "$bin" ]; then
      printf '%s\n' "$bin"
      return 0
    fi
  done
  IFS="$saved_ifs"
  return 1
}

REAL_CARGO="$(real_cargo)"
if [ -z "$REAL_CARGO" ]; then
  echo "burst-lane-bin/cargo: no real cargo found on PATH behind this shim" >&2
  exit 127
fi
# PRD-build-cargo-route-precedence: mark every child process tree from
# here on as "already inside the burst shim" — cargo-budget-bin/cargo's
# own real_cargo() checks this before deciding whether to hand off to
# this shim, so a cargo call already routed through here (this exec, or
# the remote/local `$REAL_CARGO` run below) never gets redirected back
# into this shim a second time (no re-exec loop).
export BURST_SHIM_ACTIVE=1

# PRD-build-cargo-shim-recursion-guard protocol v2 item 3: real_cargo()
# above already skipped every known shim dir (SHIM_DIRS, including
# rustbuild's bin now), so $REAL_CARGO here is always the confirmed
# non-shim real cargo — clear the guard state so the child (the real
# cargo, and anything it shells back out to) starts a fresh chain.
unset WM_CARGO_SHIM_CHAIN WM_CARGO_SHIM_DEPTH

route=0
sub="${1:-}"
sub_disp="${sub:--}"
case "$sub" in
  build|test|clippy|deny|nextest) route=1 ;;
esac

if [ "$route" -eq 1 ]; then
  if [ "${BURST_LANE:-0}" = "1" ] && [ -x "$WRAPPER" ]; then
    status_out="$("$WRAPPER" status 2>/dev/null)"
    if [ "$status_out" != "no active session" ] && [ -n "$status_out" ]; then
      route_log "$sub_disp" burst routed
      exec "$WRAPPER" run "$PWD" -- "$REAL_CARGO" "$@"
    fi
    route_log "$sub_disp" local no-session
    echo "burst-lane: no session, local" >&2
  else
    cause="burst-lane-disabled"
    [ ! -x "$WRAPPER" ] && cause="wrapper-missing"
    route_log "$sub_disp" local "$cause"
  fi
else
  route_log "$sub_disp" passthrough unrouted-subcommand
fi

# PRD-build-burst-pull-on-demand requirement 2: every local-cargo path this
# shim can fall through to (unrouted subcommands like `check`/`metadata`, a
# routed subcommand with BURST_LANE unset, or the no-session branch just
# above) lands here — the single choke point where a worktree a burst-lane
# `run` elsewhere marked remote-dirty must be pulled fresh before it is read
# locally. Fails open (never blocks the caller) if burst-lane.sh is missing.
if [ -x "$WRAPPER" ]; then
  "$WRAPPER" ensure-fresh "$PWD" >/dev/null 2>&1 || true
fi
exec "$REAL_CARGO" "$@"
